{
	"name": "obsidian-trilium-sync",
	"version": "0.1.0",
	"description": "Sync Obsidian notes to Trilium Notes via ETAPI",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^18.19.130",
		"esbuild": "^0.25.12",
		"tslib": "^2.4.0",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"obsidian": ">=0.15.0 <2.0.0"
	}
}
